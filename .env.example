CLOUDSDK_CORE_PROJECT=aitrailblazer-ai-publishing
GOOGLE_CLOUD_PROJECT=aitrailblazer-ai-publishing
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
PUBLISHING_USE_GEMINI=false
GEMINI_MODEL=gemini-2.5-flash
PUBLISHING_AGENT_URL=http://localhost:8080
MONGODB_URI=
MONGODB_DATABASE=aitrailblazer_demo
MCP_SERVER_URL=
MCP_METHOD=tools/call
MCP_TOOL_NAME=find
MCP_SESSION_ID=aitrailblazer-judge-proof
MCP_AUTHORIZATION=
MCP_API_KEY=
MDB_MCP_CONNECTION_STRING=
MDB_MCP_API_CLIENT_ID=
MDB_MCP_API_CLIENT_SECRET=
MDB_MCP_READ_ONLY=true
MDB_MCP_TELEMETRY=disabled
MDB_MCP_EXTERNALLY_MANAGED_SESSIONS=true
MDB_MCP_HTTP_RESPONSE_TYPE=json
MONGODB_MCP_HOST=127.0.0.1
MONGODB_MCP_PORT=3000
AGENT_BUILDER_AGENT_ID=
AGENT_BUILDER_ENDPOINT=
AGENT_BUILDER_TOKEN=
AGENT_BUILDER_MODE=
DEMO_SESSION_ID=demo-session-001

# Optional app-level key for protecting public demo routes.
# Leave blank for local development. Set in Secret Manager for judge demos.
PUBLISHING_DEMO_API_KEY=

# Optional local test-spend tracker.
# This is an immediate per-request estimate for demos. Exact Google Cloud
# spend/credits still require Cloud Billing export or the Billing console.
PUBLISHING_COST_TRACKING=false
PUBLISHING_GOOGLE_CREDIT_BUDGET_USD=500
PUBLISHING_ESTIMATED_ARCHIVE_BRIEF_COST_USD=0.00
PUBLISHING_ESTIMATED_TRIPCODE_COST_USD=0.00
PUBLISHING_ESTIMATED_JUDGE_DEMO_COST_USD=0.00
PUBLISHING_ESTIMATED_SESSION_MEMORY_COST_USD=0.00
PUBLISHING_COST_SOURCE=local-estimate
